{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window and event access shared by every Holdem window",
  "windows": [
    "main",
    "popup",
    "settings",
    "updater",
    "consent",
    "whats-new"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-hide"
  ]
}
