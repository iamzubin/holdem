{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shelf",
  "description": "Read dropped text snippets so they can be dragged back out as text",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$TEMP/holdem_drops/**"
        }
      ]
    }
  ]
}
