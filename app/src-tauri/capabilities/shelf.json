{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "shelf",
  "description": "Drag files out of the shelf: focus the window first, and read text snippets to drag them out as text",
  "windows": [
    "main",
    "popup"
  ],
  "permissions": [
    "core:window:allow-set-focus",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$TEMP/holdem_drops/**"
        }
      ]
    }
  ]
}
